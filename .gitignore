__pycache__/
*.pyc
.env
.DS_Store
.claude/worktrees/
client/target/
server/target/
server/worker/build/
server/worker/.wrangler/
# wrangler dev's local vars and secrets (GOOGLE_SIGNIN_*, ADR-0040).
server/worker/.dev.vars
/.wrangler/
HANDOFF.md

# Throwaway prototypes are their own cargo workspaces (deliberately outside
# `server/`'s, so CI's `--workspace` never gates on them), so they have their
# own build dirs and lockfiles.
server/prototypes/*/target/
server/prototypes/*/Cargo.lock


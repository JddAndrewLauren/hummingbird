{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "build-version.node.ts",
    // The pure half `build-version.node.ts` feeds. It is `src/`-resident
    // (the browser reads it too) but a composite project must list every
    // file it compiles, so it appears in both projects rather than the
    // node-only I/O half moving under `src/`, where `node:child_process`
    // could be pulled into the browser bundle.
    "src/shell/build-version.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "visual/**/*.ts",
    "csp-worker/**/*.ts"
  ]
}

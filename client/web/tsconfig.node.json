{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "build-version.node.ts",
    // The pure half `build-version.node.ts` feeds. It is `src/`-resident
    // (the browser reads it too) but a composite project must list every
    // file it compiles, so it appears in both projects rather than the
    // node-only I/O half moving under `src/`, where `node:child_process`
    // could be pulled into the browser bundle.
    "src/shell/build-version.ts",
    // Same arrangement, different reason: `visual/surfaces.spec.ts` drives the
    // phone project's More sheet, and which screens are behind it is the app's
    // own decision (`nav-bar.ts`). Importing it is what stops the spec from
    // keeping a second, drifting copy of that partition. Both files are pure
    // TypeScript with no import from `components/` — deliberately, since this
    // project has no JSX; `screen-icons.ts` holds the half that does.
    "src/shell/nav-bar.ts",
    "src/shell/screens.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "visual/**/*.ts",
    "csp-worker/**/*.ts"
  ]
}

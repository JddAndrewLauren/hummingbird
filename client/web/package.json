{
  "name": "hummingbird-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build:wasm": "wasm-pack build --target bundler --out-dir ../web/src/wasm/pkg ../ffi-web",
    "dev": "pnpm run build:wasm && vite",
    "build": "pnpm run build:wasm && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run build:wasm && tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "visual": "playwright test",
    "wrangler:dev": "pnpm run build && wrangler dev",
    "assert-no-fixtures": "node scripts/assert-no-fixtures.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-top-level-await": "^1.4.4",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^2.1.8",
    "workbox-window": "^7.3.0",
    "wrangler": "^4.0.0"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The glance host (ADR-0041). Keeps the process alive and nothing else:
     no StartInterval, because the host's own loop owns its cadence. No
     secret belongs here; both live in the login Keychain (README.md). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.twinion.hummingbird.glance</string>
  <key>ProgramArguments</key>
  <array>
    <string>JOHN_HOME/.local/bin/hummingbird-glance</string>
    <string>JOHN_HOME/Library/Application Support/hummingbird-glance</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardErrorPath</key>
  <string>JOHN_HOME/Library/Logs/hummingbird-glance.log</string>
  <key>StandardOutPath</key>
  <string>JOHN_HOME/Library/Logs/hummingbird-glance.log</string>
</dict>
</plist>

<!-- Lucide `x` at 24dp — the item detail panel's close control (the web
     ItemPanel's own top-right IconButton) — outline, 1.75px stroke, rounded
     caps, `ic_inbox.xml`'s recipe. Drawn in white and tinted at use: icons
     never carry colour independently of their label. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M18,6 6,18"
        android:strokeWidth="1.75"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="m6,6 12,12"
        android:strokeWidth="1.75"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

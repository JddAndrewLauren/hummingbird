<?xml version="1.0" encoding="utf-8"?>
<!-- The main launcher's themed-icon (Android 13+ monochrome) layer.
     Android builds the themed icon from this drawable's ALPHA only, tinted
     by the system — a full-colour bitmap like ic_launcher_foreground.png
     would rasterise as a solid opaque blob (#528 review finding), so the
     monochrome slot needs its own alpha-carrying art, not the bird
     artwork. Lucide `feather` (the design system's capture glyph),
     stroked-only so the interior stays transparent and the silhouette
     reads distinctly from the capture alias's `plus` below. Same safe-zone
     math as the bitmap foreground: the 24-unit glyph is scaled x2 and
     centred (108 - 48 = 60, so translate 30). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2"
        android:pivotX="0"
        android:pivotY="0">
        <path
            android:pathData="M12.67,19a2,2 0 0,0 1.416,-0.588l6.154,-6.172a6,6 0 0,0 -8.49,-8.49L5.586,9.914A2,2 0 0,0 5,11.328V18a1,1 0 0,0 1,1z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M16,8L2,22"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M17.5,15H9"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The capture alias's themed-icon (Android 13+ monochrome) layer — see
     ic_launcher_monochrome.xml's header for why this can't be the bitmap
     foreground. Lucide `plus` (the mint/quick-add verb), where the main
     icon's monochrome layer uses `feather`, so the two entries stay
     tellable apart under a themed icon pack too. Same safe-zone math: the
     24-unit glyph is scaled x2 and centred (108 - 48 = 60, translate 30). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2"
        android:pivotX="0"
        android:pivotY="0">
        <path
            android:pathData="M12,5L12,19"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M5,12L19,12"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.75"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The real app icon (#528): the light plate from the repo's only brand
     mark, client/web/public/app-icon-512.png, hand-ported into a foreground
     bitmap inset in the adaptive-icon safe zone, on a solid background
     matching the artwork's own plate. The themed-icon (monochrome) layer
     is separate art, not this bitmap — see ic_launcher_monochrome.xml's
     header for why. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

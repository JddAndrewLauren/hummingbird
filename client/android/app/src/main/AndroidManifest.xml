<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The sync cycle and nothing else reaches the network (the core owns
         HTTP per ADR-0003; this is its permission). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- #710's `NetworkMonitor`: `ConnectivityManager.registerDefaultNetworkCallback`/
         `getNetworkCapabilities` need this to read transport and capability
         bits at all — a normal (install-time, non-runtime) permission, no
         prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CaptureActivity's mic button: on-device SpeechRecognizer needs this
         to record, requested at tap-time (M1-5/#503), never at launch. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The alert lane's ring (M2/#141, ADR-0012). minSdk is 35, so this is
         always a runtime grant — `MainActivity` asks on first composition,
         and `AlertsScreen`'s health row surfaces a refusal rather than
         letting alerts silently not arrive. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The urgent channel's DND bypass (M2/#141, ADR-0012: "a filter built
         to cut through blanket silencing must not get caught in it"). Not a
         permission the app is granted by declaring it — the grant is the
         user's, in Settings > Do Not Disturb access — but declaring it is
         what puts hummingbird in that list at all. Without this line
         `NotificationChannel.setBypassDnd(true)` is inert forever, and
         `AlertsScreen`'s health row points at a screen where the app cannot
         be found. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".HummingbirdApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hummingbird">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Static shortcuts (long-press the launcher icon) declare
                 against the primary launcher activity per platform
                 convention; CaptureLauncher below is the second, always-on
                 entry point the same target resolves to. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- CaptureActivity: capture's whole surface (M1-5/#503). Reached
             through the two aliases below — the CaptureLauncher icon and
             the ShareTarget share-sheet entry (#782) — and the static
             shortcut above; never through an intent-filter of its own.
             Every filter lives on an alias, so there is exactly one entry
             per *door*: the launcher icon is one, the share sheet is
             another, and each names itself (icon, label) independently
             over the same Activity, one process and one core. -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:theme="@style/Theme.Hummingbird"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- The second launcher icon (#128's own scope, resolved by the
             2026-08-14 grilling): a distinct icon and label over the same
             CaptureActivity, so the OS shows two app entries that share one
             process and one core. Untouched by #782, which adds a sibling
             rather than widening this one — a share filter here would put
             the "Capture" label in the share sheet. -->
        <activity-alias
            android:name=".CaptureLauncher"
            android:targetActivity=".CaptureActivity"
            android:label="@string/capture_launcher_label"
            android:icon="@mipmap/ic_launcher_capture"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The share-sheet door (#782): the same CaptureActivity, under the
             app's own name and the capture icon, for a `text/plain` SEND
             and nothing wider — images, files and SEND_MULTIPLE are out of
             scope, so they are not filtered. Exported by necessity: the
             sharing app is the caller. What arrives is a subject and a
             text, seeded into the capture form through the core's own
             mapping (`parseSharePayload`); the form is attended, never
             minted unseen (ADR-0022). -->
        <activity-alias
            android:name=".ShareTarget"
            android:targetActivity=".CaptureActivity"
            android:label="@string/share_target_label"
            android:icon="@mipmap/ic_launcher_capture"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- The FCM entry point (M2/#141). `exported="false"`: the only
             caller is Google Play services, which binds it through the
             MESSAGING_EVENT action rather than by export. -->
        <service
            android:name=".push.HbMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The notification's Ack action (ADR-0012). `exported="false"`:
             the only sender is this app's own PendingIntent, and an
             exported receiver would let any app settle alerts. -->
        <receiver
            android:name=".push.AckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="net.twinion.hummingbird.action.ACK_ALERT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

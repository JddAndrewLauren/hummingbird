<!-- Lucide `arrow-up` at 24dp — the Now strip's calm-order direction, drawn
     inside the selected Urgency chip (up is oldest first). The web's toggle carries
     the same glyph (`Icon.tsx`'s `arrow-up`), so both clients point the same
     way. Outline, 1.75px stroke, rounded caps — `ic_arrow_up_right.xml`'s
     recipe; drawn in white and tinted at use. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="m5 12 7-7 7 7"
        android:strokeWidth="1.75"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M12 19V5"
        android:strokeWidth="1.75"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The column-collapse affordance's glyph (NowScreen, M3/#530): feather's
     "chevron-down", drawn locally for the same reason `ic_mic.xml` states
     (no several-MB icon atlas for one glyph).

     It exists because the design system's ICONOGRAPHY rule is "Unicode as
     icons: never" and the header was drawing "▸"/"▾" — the app's only
     violation of it. One drawable, not two: the collapsed direction is the
     same mark rotated at the call site, so a chevron can never point two
     ways for two different reasons.

     Tinted at the call site (`Icon`'s default `LocalContentColor`), so no
     colour is baked in here. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FF000000"
        android:pathData="M7.41,8.59 L12,13.17l4.59,-4.58L18,10l-6,6 -6,-6z" />
</vector>

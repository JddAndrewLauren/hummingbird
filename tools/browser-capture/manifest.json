{
  "manifest_version": 3,
  "name": "hummingbird capture",
  "version": "0.1.0",
  "key": "",
  "description": "Capture the current tab as a hummingbird item.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture to hummingbird"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://hb.twinion.net/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Capture the current tab"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "capture@hummingbird.twinion.net",
      "strict_min_version": "127.0"
    }
  }
}
